[Unit]
Description=Root Squad Django contact backend
After=network.target

[Service]
Type=simple
User=rootsquad
Group=www-data
WorkingDirectory=/srv/root-squad/root-squad-vue/backend
EnvironmentFile=/etc/root-squad.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/root-squad/root-squad-vue/backend/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 30 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
